<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fake News Detection"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deteksi berita FAKE atau REAL menggunakan Machine Learning"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Berita"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan judul berita"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Isi Berita"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <EditText
            android:id="@+id/edtContent"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:hint="Masukkan atau tempel isi berita..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnDetect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="DETEKSI BERITA"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LIHAT RIWAYAT"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HASIL DETEKSI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/txtResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAKE NEWS"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtModelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Linear SVM • Accuracy 98.95%"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>