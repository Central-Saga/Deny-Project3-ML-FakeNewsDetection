# Contoh konfigurasi keystore rilis untuk Android APK/AAB signing
# Salin file ini menjadi 'keystore.properties' (JANGAN commit file tersebut ke Git)
#
# Path storeFile dapat berupa path absolut atau path relatif terhadap direktori file ini.
storeFile=release-key.jks
storePassword=your_keystore_password
keyAlias=release-key
keyPassword=your_key_password
